FROM cloudflare/cloudflared:latest AS cloudflared
FROM docker:cli
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
RUN apk add --no-cache bash curl python3 coreutils grep
WORKDIR /installer
COPY truenas-file-structure.sh ./
COPY windows/build_configure.py windows/entrypoint.sh ./windows/
COPY portal/cloudflare_setup.py ./portal/
RUN python3 windows/build_configure.py > /usr/local/bin/configure-stack \
    && bash -n /usr/local/bin/configure-stack \
    && cloudflared version \
    && cloudflared tunnel login --help >/dev/null \
    && cloudflared tunnel create --help >/dev/null
ENTRYPOINT ["bash", "/installer/windows/entrypoint.sh"]
CMD ["configure"]
